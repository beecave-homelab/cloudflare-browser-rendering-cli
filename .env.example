# Cloudflare Browser Rendering CLI — environment variables
#
# The loader discovers a .env file in this order (first match wins):
#   1. ~/.config/cloudflare-browser-rendering-cli/.env
#   2. ~/.config/cbr/.env
#   3. ${PWD}/.env
#
# Existing process environment variables are preserved by default.
# Override mode (load_project_env(override=True)) replaces them with file values.

# Cloudflare API Token:
# Go to https://dash.cloudflare.com --> Overview
# Scroll down until you see `Get your API token` at the bottom right.
CLOUDFLARE_API_TOKEN=your-browser-render-api-token

# Cloudflare Account ID:
# Go to https://dash.cloudflare.com --> Overview
# Scroll down until you see `Account ID` at the bottom right.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
